rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function isAdmin() { return request.auth != null && request.auth.uid == 'ADMIN_UID_SUBSTITUA_AQUI'; }
  match /products/{imageName} {
   allow read: if true;
   allow write: if isAdmin() && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
